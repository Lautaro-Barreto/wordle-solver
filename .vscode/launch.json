    "version": "0.2.0",
    "configurations": [
        {
            "type": "msedge",
            "trace": true,
            "request": "launch",
            "name": "Launch Edge against localhost",
            "url": "http://localhost:5174",
            "webRoot": "${workspaceFolder}/wordle-solver",
            "sourceMapPathOverrides": {
                "webpack:///src/*": "${webRoot}/src/*",
                "http://localhost:5174/src/*": "${webRoot}/src/*"
            }
        }
    ]
}